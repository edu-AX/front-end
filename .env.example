# 이 파일을 복사해서 .env.local 로 이름을 바꾼 뒤 값을 채우세요.
# .env.local 은 git에 올라가지 않습니다.

# Gemini API 키 (Google AI Studio 에서 발급). 서버에서만 읽습니다.
# 절대 NEXT_PUBLIC_ 을 앞에 붙이지 마세요 — 붙이면 브라우저에 노출됩니다.
GEMINI_API_KEY=

# 쓸 모델. 비워 두면 gemini-3.5-flash-lite (빠르고 저렴, 테스트에서 1~2초).
# gemini-3.8-flash 는 테스트 당시 과부하(503)가 잦았음.
GEMINI_MODEL=

# true 로 두면 API를 부르지 않고 미리 정한 답만 돌려줍니다 (인터넷 없이 발표할 때).
DEMO_MODE=false

# 데모에서 "오늘"로 쓸 날짜. 비워 두면 실제 오늘 날짜를 씁니다.
# 2027-03-11 이면 수학여행(2027-05-12)이 D-62 로 보입니다.
NEXT_PUBLIC_DEMO_TODAY=2027-03-11
