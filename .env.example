# 이 파일을 복사해서 .env.local 로 이름을 바꾼 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)
# 프론트에는 API 키가 없습니다. AI 키(GEMINI_API_KEY)는 백엔드(edu-AX/back-end)에만 둡니다.

# 백엔드 API 주소. 비워 두면 http://localhost:3001 (백엔드를 로컬에서 npm run dev 로 띄운 주소)
# 배포 예: https://edu-ax-back.vercel.app
NEXT_PUBLIC_API_BASE_URL=

# 데모에서 "오늘"로 쓸 날짜. 2027-03-11 이면 수학여행(2027-05-12)이 D-62 로 보입니다.
# 백엔드의 NEXT_PUBLIC_DEMO_TODAY 와 같은 값으로 맞추세요 (챗봇의 D-day 계산이 같아지도록).
NEXT_PUBLIC_DEMO_TODAY=2027-03-11
